<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.vaibhav.kundli.ui.auth.SplashFragment"
        android:label="Splash">
        <action android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.vaibhav.kundli.ui.auth.LoginFragment"
        android:label="Login">
        <action android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.vaibhav.kundli.ui.auth.RegisterFragment"
        android:label="Register">
        <action android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.vaibhav.kundli.ui.auth.ForgotPasswordFragment"
        android:label="Forgot Password" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.vaibhav.kundli.ui.home.HomeFragment"
        android:label="Home">
        <action android:id="@+id/action_homeFragment_to_birthDetailsFragment"
            app:destination="@id/birthDetailsFragment" />
        <action android:id="@+id/action_homeFragment_to_horoscopeFragment"
            app:destination="@id/horoscopeFragment" />
        <action android:id="@+id/action_homeFragment_to_compatibilityFragment"
            app:destination="@id/compatibilityFragment" />
        <action android:id="@+id/action_homeFragment_to_remediesFragment"
            app:destination="@id/remediesFragment" />
        <action android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action android:id="@+id/action_homeFragment_to_premiumFragment"
            app:destination="@id/premiumFragment" />
        <action android:id="@+id/action_homeFragment_to_kundliListFragment"
            app:destination="@id/kundliListFragment" />
    </fragment>

    <fragment
        android:id="@+id/kundliListFragment"
        android:name="com.vaibhav.kundli.ui.kundli.KundliListFragment"
        android:label="My Kundlis">
        <action android:id="@+id/action_kundliListFragment_to_kundliChartFragment"
            app:destination="@id/kundliChartFragment" />
        <action android:id="@+id/action_kundliListFragment_to_birthDetailsFragment"
            app:destination="@id/birthDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/birthDetailsFragment"
        android:name="com.vaibhav.kundli.ui.kundli.BirthDetailsFragment"
        android:label="Birth Details">
        <action android:id="@+id/action_birthDetailsFragment_to_kundliChartFragment"
            app:destination="@id/kundliChartFragment" />
    </fragment>

    <fragment
        android:id="@+id/kundliChartFragment"
        android:name="com.vaibhav.kundli.ui.kundli.KundliChartFragment"
        android:label="Kundli Chart" />

    <fragment
        android:id="@+id/horoscopeFragment"
        android:name="com.vaibhav.kundli.ui.horoscope.HoroscopeFragment"
        android:label="Horoscope" />

    <fragment
        android:id="@+id/compatibilityFragment"
        android:name="com.vaibhav.kundli.ui.compatibility.CompatibilityFragment"
        android:label="Compatibility" />

    <fragment
        android:id="@+id/remediesFragment"
        android:name="com.vaibhav.kundli.ui.remedies.RemediesFragment"
        android:label="Remedies" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.vaibhav.kundli.ui.profile.ProfileFragment"
        android:label="Profile">
        <action android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action android:id="@+id/action_profileFragment_to_premiumFragment"
            app:destination="@id/premiumFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.vaibhav.kundli.ui.profile.EditProfileFragment"
        android:label="Edit Profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.vaibhav.kundli.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.vaibhav.kundli.ui.premium.PremiumFragment"
        android:label="Premium" />

</navigation>
