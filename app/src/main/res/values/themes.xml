<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KundliApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color attributes -->
        <item name="colorPrimary">@color/primary_saffron</item>
        <item name="colorPrimaryContainer">@color/primary_saffron</item>
        <item name="colorPrimaryVariant">@color/deep_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/primary_gold</item>
        <item name="colorSecondaryContainer">@color/primary_gold</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/accent_red</item>
        <!-- Status and Navigation Bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.KundliApp.Light" parent="Theme.Material3.Light.NoActionBar">
        <!-- Color attributes -->
        <item name="colorPrimary">@color/primary_saffron</item>
        <item name="colorPrimaryContainer">@color/primary_saffron</item>
        <item name="colorPrimaryVariant">@color/deep_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/primary_gold</item>
        <item name="colorSecondaryContainer">@color/primary_gold</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A0533</item>
        <item name="colorBackground">#F5F0FF</item>
        <item name="colorOnBackground">#1A0533</item>
        <item name="colorError">@color/accent_red</item>
    </style>
</resources>
