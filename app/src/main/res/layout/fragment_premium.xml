<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/go_premium"
                android:textColor="@color/primary_gold"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_desc"
                android:textColor="@color/text_secondary"
                android:textAlignment="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Features List -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="@dimen/card_corner_radius">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium Features"
                    android:textColor="@color/primary_gold"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Unlimited Kundli Generation" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Advanced Yoga Analysis" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Detailed Dasha Predictions" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Personalized Remedies" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Ad-Free Experience" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" android:layout_marginBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓ Priority Support" android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Monthly Plan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="@color/primary_saffron"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Billed monthly"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="₹99/mo"
                    app:backgroundTint="@color/primary_saffron"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Yearly Plan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="@color/primary_gold"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yearly"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" BEST VALUE"
                            android:textColor="@color/accent_green"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save 36% vs Monthly"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYearly"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="₹799/yr"
                    app:backgroundTint="@color/primary_gold"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnRestorePurchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restore_purchase"
            android:textColor="@color/primary_gold"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="32dp" />

        <!-- Watch Ad for free trial -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchAd"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="📺  Watch Ad for 1 Day Free Access"
            app:backgroundTint="@color/card_dark"
            app:cornerRadius="28dp"
            app:strokeColor="@color/primary_saffron"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
